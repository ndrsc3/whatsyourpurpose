{
    "name": "whats-your-purpose",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint src/ api/ lib/ vite.config.ts",
        "format": "prettier --write src/ api/ scripts/ vite.config.ts *.json",
        "setup-admin": "tsx scripts/setup-admin.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --test 'scripts/*.test.mjs'",
        "smoke": "node scripts/smoke-api.mjs",
        "check": "npm run lint && npm test && npm run build && npm run smoke",
        "dev:check": "node scripts/dev-check.mjs",
        "dev:full": "node scripts/dev-check.mjs && vercel dev",
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
    },
    "dependencies": {
        "@vercel/kv": "^0.2.4",
        "jsonwebtoken": "^9.0.2",
        "openai": "^4.77.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/node": "^20.0.0",
        "@vercel/node": "^5.0.0",
        "dotenv": "^16.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "jiti": "^2.0.0",
        "prettier": "^3.0.0",
        "tsx": "^4.0.0",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^6.0.0"
    }
}
